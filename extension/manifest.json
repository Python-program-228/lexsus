{
  "manifest_version": 3,
  "name": "AI Continuity Bridge",
  "version": "0.2.0",
  "description": "Pairs ChatGPT, Claude.ai, Gemini and Grok with the local AI Continuity Bridge desktop app: handoffs in, local tool calls out.",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": [
    "ws://127.0.0.1:45241/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://grok.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["tool-spec.js", "chat-adapters.js", "ui-components.js", "content-core.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://claude.ai/*", "https://gemini.google.com/*", "https://grok.com/*"],
      "js": ["tool-spec.js", "chat-adapters.js", "ui-components.js", "content-core.js", "content-any.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Continuity Bridge"
  }
}
